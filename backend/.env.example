# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# Main model for reasoning: analysis, gaps, experiment plans, drafting
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Cheaper/faster model for scoring papers and building search queries
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-4.5

# Hard ceiling for any single AI answer. Each call already uses a smaller limit (see TOKENS in app/config.py);
# lower this (e.g. 3000) if OpenRouter says you cannot afford the request
MAX_OUTPUT_TOKENS=4000

# --- Paper search (OpenAlex) ---
# Free key from openalex.org/settings/api. Without it you only get about $0.10 of searches per day.
OPENALEX_API_KEY=

# --- App ---
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
DB_PATH=research_mentor.db
# Needed only to add mentors through POST /api/admin/mentors
ADMIN_KEY=change-me-too
